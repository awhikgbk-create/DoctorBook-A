@model IEnumerable<Appointment>
@{ViewData["Title"]="لوحة الطبيب";var d=(DoctorProfile)ViewBag.Doctor;}
<section class="section page-section"><div class="section-heading"><div><span class="eyebrow">لوحة التحكم</span><h1>مرحبًا @d.FullName</h1><p class="muted">حالة الحساب: @(d.IsApproved?"معتمد":"بانتظار مراجعة الإدارة")</p></div><div class="actions"><a class="btn small" asp-action="Profile">تعديل الملف</a><a class="btn small" asp-action="Schedule">جدول المواعيد</a></div></div><div class="stats"><div><strong>@Model.Count()</strong><span>كل الحجوزات</span></div><div><strong>@ViewBag.Pending</strong><span>طلبات جديدة</span></div></div><h2>الحجوزات</h2><div class="table-wrap"><table><thead><tr><th>المريض</th><th>الهاتف</th><th>التاريخ</th><th>الوقت</th><th>الحالة</th><th>إدارة</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.PatientName</td><td>@a.PatientPhone</td><td>@a.AppointmentDate.ToString("yyyy/MM/dd")</td><td>@a.AppointmentTime.ToString(@"hh\:mm")</td><td>@a.Status</td><td><form asp-action="UpdateStatus" method="post" class="inline-form"><input type="hidden" name="id" value="@a.Id"/><select name="status"><option value="Confirmed">تأكيد</option><option value="Completed">مكتمل</option><option value="Cancelled">إلغاء</option></select><button class="btn small">حفظ</button></form></td></tr>}</tbody></table></div></section>
