@model IEnumerable<Appointment>
@{ViewData["Title"]="إدارة المنصة";}
<section class="section page-section"><span class="eyebrow">لوحة الإدارة</span><h1>ملخص المنصة</h1><div class="stats"><div><strong>@ViewBag.Doctors</strong><span>الأطباء</span></div><div><strong>@ViewBag.PendingDoctors</strong><span>طلبات اعتماد</span></div><div><strong>@ViewBag.Appointments</strong><span>الحجوزات</span></div><div><strong>@ViewBag.PendingAppointments</strong><span>حجوزات معلقة</span></div></div><div class="actions"><a class="btn" asp-action="Doctors">إدارة الأطباء</a><a class="btn" asp-action="PromotePatient">تحويل مريض إلى طبيب</a><a class="btn" asp-action="Appointments">إدارة الحجوزات</a></div><h2>أحدث الحجوزات</h2><div class="table-wrap"><table><thead><tr><th>الطبيب</th><th>المريض</th><th>التاريخ</th><th>الحالة</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Doctor?.FullName</td><td>@a.PatientName</td><td>@a.AppointmentDate.ToString("yyyy/MM/dd")</td><td>@a.Status</td></tr>}</tbody></table></div></section>
