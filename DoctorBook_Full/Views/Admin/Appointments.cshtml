@model IEnumerable<Appointment>
@{ViewData["Title"]="إدارة الحجوزات";}
<section class="section page-section"><h1>إدارة جميع الحجوزات</h1><div class="table-wrap"><table><thead><tr><th>الطبيب</th><th>المريض</th><th>الهاتف</th><th>التاريخ</th><th>الحالة</th><th>الدفع</th><th>إجراء</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Doctor?.FullName</td><td>@a.PatientName</td><td>@a.PatientPhone</td><td>@a.AppointmentDate.ToString("yyyy/MM/dd")</td><td>@a.Status</td><td>@a.Payment?.Status</td><td><form asp-action="UpdateAppointment" method="post" class="inline-form"><input type="hidden" name="id" value="@a.Id"/><select name="status"><option value="Pending">معلق</option><option value="Confirmed">مؤكد</option><option value="Cancelled">ملغي</option><option value="Completed">مكتمل</option></select><button class="btn small">تحديث</button></form>@if(a.Payment?.Status!="Paid"){<form asp-action="MarkPaid" method="post"><input type="hidden" name="id" value="@a.Id"/><button class="btn small">تسجيل الدفع نقدًا</button></form>}</td></tr>}</tbody></table></div></section>
