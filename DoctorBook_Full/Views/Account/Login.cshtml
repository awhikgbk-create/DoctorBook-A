@model LoginViewModel
@{ViewData["Title"]="تسجيل الدخول";}
<section class="section page-section"><div class="form-card"><h1>تسجيل الدخول</h1><form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation"></div><label>البريد الإلكتروني</label><input asp-for="Email"/><label>كلمة المرور</label><input asp-for="Password"/><label class="check"><input asp-for="RememberMe"/> تذكرني</label><button class="btn">دخول</button><p>ليس لديك حساب؟ <a asp-action="Register">إنشاء حساب</a></p></form></div></section>
