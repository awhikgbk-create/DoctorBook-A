@model Appointment
@{ViewData["Title"]="حجز موعد";var d=(DoctorProfile)ViewBag.Doctor;}
<section class="section page-section"><div class="form-card"><h1>حجز موعد مع @d.FullName</h1><p class="muted">@d.Specialty — @d.City</p><form asp-action="Create" method="post"><input type="hidden" asp-for="DoctorProfileId"/><div asp-validation-summary="All" class="validation"></div><label>اسم المريض</label><input asp-for="PatientName"/><label>رقم الهاتف</label><input asp-for="PatientPhone"/><label>التاريخ</label><input asp-for="AppointmentDate" type="date"/><label>وقت الموعد (حسب جدول الطبيب)</label><input asp-for="AppointmentTime" type="time"/><label>ملاحظات</label><textarea asp-for="Notes"></textarea><p class="muted">الدفع في هذه النسخة: نقدًا في العيادة. لا يتم تحصيل أموال إلكترونيًا.</p><button class="btn">إرسال طلب الحجز</button></form></div></section>
