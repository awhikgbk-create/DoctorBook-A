@model DoctorBook.ViewModels.PromoteDoctorViewModel
@{ViewData["Title"]="تحويل مريض إلى طبيب";}
<section class="section page-section"><div class="form-card"><h1>تحويل حساب مريض إلى طبيب</h1><p>ابحث برقم المستخدم. سيتم الاحتفاظ بنفس الحساب وكلمة المرور.</p>@if(ViewBag.LookupMessage!=null){<div class="notice">@ViewBag.LookupMessage</div>}<form method="get" asp-action="PromotePatient"><label>رقم المستخدم</label><input name="publicId" value="@Model.PublicId" placeholder="معرّف الحساب الكامل"/><button class="btn" type="submit">بحث عن الحساب</button></form><hr/><form method="post" asp-action="PromotePatient"><div asp-validation-summary="All" class="validation"></div><input asp-for="PublicId" type="hidden"/><label>اسم الطبيب</label><input asp-for="FullName"/><label>التخصص</label><input asp-for="Specialty"/><label>المدينة</label><input asp-for="City"/><label>عنوان العيادة</label><input asp-for="ClinicAddress"/><label>رقم التواصل العام</label><input asp-for="PublicPhone"/><label>نبذة مهنية</label><textarea asp-for="Bio"></textarea><label>سعر الكشف</label><input asp-for="ConsultationPrice" type="number" min="0"/><button class="btn" type="submit">تفعيل حساب الطبيب</button></form></div></section>
