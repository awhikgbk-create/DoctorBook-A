@model IEnumerable<DoctorProfile>
@{ViewData["Title"]="الرئيسية"; var doctors=Model.ToList();}
<section class="hero-modern"><div class="hero-copy"><div class="eyebrow"><span class="pulse-dot"></span> رعاية صحية أقرب إليك</div><h1>اطمّن على صحتك،<br><span>واختار طبيبك بثقة.</span></h1><p>اكتشف الأطباء المعتمدين، قارن التخصصات، واحجز موعدك بسهولة من مكان واحد.</p>
<form method="get" class="hero-search"><label class="search-field"><span>⌕</span><input name="specialty" value="@ViewBag.Specialty" placeholder="ابحث بالتخصص، مثال: قلب" aria-label="التخصص"></label><label class="search-field"><span>⌖</span><input name="city" value="@ViewBag.City" placeholder="المدينة أو المحافظة" aria-label="المدينة"></label><button class="btn search-submit">ابحث عن طبيب <b>←</b></button></form>
<div class="trust-row"><div class="trust-avatars"><span>د</span><span>ط</span><span>✚</span></div><div><strong>اختيار أسهل لرعايتك</strong><small>كل ما تحتاجه في تجربة واحدة</small></div></div></div>
<div class="hero-visual"><div class="hero-photo"><img src="https://www.aragon.ai/images/reimagine/healthcare/4.jpg" alt="طبيب في عيادة حديثة"/><div class="photo-shade"></div><img class="doctor-photo-secondary" src="https://assets-global.website-files.com/650b1c3798ca5b7e4f67e74e/6560d9aa914b06c00e99a06b_doctor.webp" alt="طبيب في بيئة طبية"/><div class="photo-caption"><span class="caption-icon">✚</span><div><strong>رعايتك أولويتنا</strong><small>صور توضيحية لبيئة الرعاية الطبية</small></div></div></div><div class="floating-note"><span class="note-icon">✓</span><div><strong>أطباء معتمدون</strong><small>ملفات تتم مراجعتها</small></div></div><div class="decor-dot dot-one"></div><div class="decor-dot dot-two"></div></div></section>
<section class="quick-benefits"><div><span>⌕</span><section><strong>بحث بسيط وسريع</strong><small>وصل للتخصص المناسب</small></section></div><div><span>◷</span><section><strong>مواعيد واضحة</strong><small>اعرف مواعيد الطبيب</small></section></div><div><span>♡</span><section><strong>قرار بثقة</strong><small>اطّلع على بيانات الطبيب</small></section></div></section>
<section class="section specialty-section"><div class="section-heading"><div><span class="eyebrow">تصفح حسب احتياجك</span><h2>ابحث حسب التخصص</h2><p>اختار المجال الطبي للوصول إلى الطبيب المناسب.</p></div><a asp-controller="Doctors" asp-action="Index">عرض كل التخصصات ←</a></div><div class="specialty-grid"><a asp-controller="Doctors" asp-action="Index" asp-route-specialty="قلب"><span>♡</span><strong>القلب</strong><small>أمراض القلب والأوعية</small></a><a asp-controller="Doctors" asp-action="Index" asp-route-specialty="أطفال"><span>✿</span><strong>الأطفال</strong><small>صحة ونمو الطفل</small></a><a asp-controller="Doctors" asp-action="Index" asp-route-specialty="جلدية"><span>✧</span><strong>الجلدية</strong><small>العناية بالبشرة</small></a><a asp-controller="Doctors" asp-action="Index" asp-route-specialty="عظام"><span>⌁</span><strong>العظام</strong><small>العظام والمفاصل</small></a><a asp-controller="Doctors" asp-action="Index" asp-route-specialty="أسنان"><span>✚</span><strong>الأسنان</strong><small>صحة الفم والأسنان</small></a><a asp-controller="Doctors" asp-action="Index" asp-route-specialty="باطنة"><span>＋</span><strong>الباطنة</strong><small>الصحة العامة</small></a></div></section>
<section class="section doctors-section"><div class="section-heading"><div><span class="eyebrow">اختيارات من دليلنا</span><h2>أطباء متاحون للحجز</h2><p>ملفات الأطباء المعتمدة والظاهرة حاليًا على المنصة.</p></div><a asp-controller="Doctors" asp-action="Index">اكتشف جميع الأطباء ←</a></div>
@if(doctors.Any()) {<div class="doctor-grid">@foreach(var d in doctors.Take(6)){<article class="doctor-card"><div class="doctor-avatar"><span>✚</span><i>✓ معتمد</i></div><span class="tag">@d.Specialty</span><h3>@d.FullName</h3><p class="doctor-location">⌖ @d.City</p><p class="doctor-bio">@(string.IsNullOrWhiteSpace(d.Bio)?"تعرف على بيانات الطبيب ومواعيد الحجز المتاحة.":d.Bio)</p><div class="card-bottom"><div><small>سعر الكشف</small><strong>@d.ConsultationPrice.ToString("0") <small>جنيه</small></strong></div><a class="btn small" asp-controller="Doctors" asp-action="Details" asp-route-id="@d.Id">عرض الملف ←</a></div></article>}</div>}else{<div class="empty-state"><span>✚</span><h3>قريبًا ستجد أطباءك هنا</h3><p>لا توجد ملفات أطباء معتمدة منشورة حاليًا. يمكنك العودة لاحقًا أو تجربة البحث.</p><a class="btn" asp-controller="Doctors" asp-action="Index">تصفح دليل الأطباء</a></div>}
</section>
<section class="how-section"><div class="how-inner"><div><span class="eyebrow">خطوات بسيطة</span><h2>حجزك يبدأ من هنا</h2><p>من البحث وحتى تأكيد الموعد، صممنا التجربة لتكون واضحة وسهلة.</p><a class="btn" asp-controller="Doctors" asp-action="Index">ابحث عن طبيب الآن</a></div><div class="steps"><article><b>01</b><div><strong>ابحث عن التخصص</strong><p>استخدم التخصص أو المدينة للوصول لنتائج مناسبة.</p></div></article><article><b>02</b><div><strong>راجع ملف الطبيب</strong><p>اطّلع على بيانات العيادة وسعر الكشف والمواعيد.</p></div></article><article><b>03</b><div><strong>اطلب موعدك</strong><p>سجّل الدخول وأرسل طلب الحجز من صفحة الطبيب.</p></div></article></div></div></section>
