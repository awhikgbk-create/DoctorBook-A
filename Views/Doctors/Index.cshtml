@model IEnumerable<DoctorProfile>
@{ViewData["Title"]="دليل الأطباء";}
<section class="directory-hero"><span class="eyebrow">دليل DoctorBook</span><h1>اختار طبيبك المناسب</h1><p>ابحث بين ملفات الأطباء المعتمدة حسب التخصص والموقع.</p><form method="get" class="directory-search"><input name="specialty" value="@Context.Request.Query["specialty"]" placeholder="التخصص الطبي" aria-label="التخصص"/><input name="city" value="@Context.Request.Query["city"]" placeholder="المدينة أو المحافظة" aria-label="المدينة"/><button class="btn">بحث عن طبيب ←</button></form></section>
<section class="section directory-results"><div class="section-heading"><div><h2>نتائج البحث</h2><p>الأطباء المعتمدون فقط يظهرون في الدليل.</p></div><span class="result-count">@Model.Count() طبيب</span></div>
@if(Model.Any()){<div class="doctor-grid">@foreach(var d in Model){<article class="doctor-card"><div class="doctor-avatar"><span>✚</span><i>✓ معتمد</i></div><span class="tag">@d.Specialty</span><h3>@d.FullName</h3><p class="doctor-location">⌖ @d.City</p><p class="doctor-bio">@(string.IsNullOrWhiteSpace(d.Bio)?"يمكنك معرفة تفاصيل الطبيب من ملفه الشخصي.":d.Bio)</p><div class="card-bottom"><div><small>سعر الكشف</small><strong>@d.ConsultationPrice.ToString("0") <small>جنيه</small></strong></div><a class="btn small" asp-action="Details" asp-route-id="@d.Id">التفاصيل ←</a></div></article>}</div>}else{<div class="empty-state"><span>⌕</span><h3>لا توجد نتائج مطابقة</h3><p>جرّب تغيير التخصص أو المدينة، أو امسح البحث لعرض كل الأطباء.</p><a class="btn" asp-action="Index">عرض كل الأطباء</a></div>}</section>
