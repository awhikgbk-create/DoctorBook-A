@model IEnumerable<DoctorSchedule>
@{ViewData["Title"]="جدول المواعيد";string[] days={"الأحد","الإثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"};}
<section class="section page-section"><div class="form-card"><h1>إضافة وقت عمل</h1><form asp-action="AddSchedule" method="post"><label>اليوم</label><select name="DayOfWeek">@for(int i=0;i<7;i++){<option value="@i">@days[i]</option>}</select><label>من</label><input type="time" name="StartTime" required/><label>إلى</label><input type="time" name="EndTime" required/><label>مدة الكشف بالدقائق</label><input type="number" name="SlotMinutes" value="30" min="5" max="240"/><button class="btn">إضافة</button></form></div><h2>الأوقات المسجلة</h2><div class="table-wrap"><table><thead><tr><th>اليوم</th><th>من</th><th>إلى</th><th>مدة الكشف</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@days[s.DayOfWeek]</td><td>@s.StartTime.ToString(@"hh\:mm")</td><td>@s.EndTime.ToString(@"hh\:mm")</td><td>@s.SlotMinutes دقيقة</td><td><form asp-action="DeleteSchedule" method="post"><input type="hidden" name="id" value="@s.Id"/><button class="btn danger small">حذف</button></form></td></tr>}</tbody></table></div></section>
